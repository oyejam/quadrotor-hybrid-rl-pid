# Vendored third-party repo (cloned by setup step in README, not committed)
external/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Model weights / logs / large artifacts
*.zip
*.pt
*.pth
*.h5
*.log
results/runs/
tb/
results/*/*.zip
results/recording_*/
results/_demo_frames/
models/*.zip
tensorboard_logs/
wandb/

# Phase 2 models are small (~300KB each) and are the only copies of these
# weights that exist anywhere -- committed deliberately so they can't be
# lost the way the phase 1 models were (see models/README.md).
!results/phase2/*/best_model.zip

# OS / IDE
.DS_Store
.idea/
.vscode/

# Data (keep folder, ignore contents: document download in data/README.md)
data/*
!data/.gitkeep
!data/README.md
