# Keep the build context small and make sure the image does its own fresh
# clone of gym-pybullet-drones rather than reusing whatever happens to be
# on the host (mirrors .gitignore, plus .git itself).
.git
external/
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Model weights / logs / large artifacts -- regenerable, not needed to build
*.zip
*.pt
*.pth
*.h5
*.log
tb/
results/recording_*/
results/_demo_frames/

# Phase 2's committed weights (see .gitignore) -- keep them in the image too,
# same exception, same reason.
!results/phase2/*/best_model.zip

# OS / IDE
.DS_Store
.idea/
.vscode/
